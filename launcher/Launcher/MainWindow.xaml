<Window x:Class="Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumina Overlay"
        Width="980" Height="620" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#0A0D14"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#121824"/>
        <SolidColorBrush x:Key="Border" Color="#26364B"/>
        <SolidColorBrush x:Key="Accent" Color="#2EE6A6"/>
        <SolidColorBrush x:Key="AccentHover" Color="#65F0C1"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#F2F7FB"/>
        <SolidColorBrush x:Key="MutedText" Color="#91A0B5"/>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#07130F"/><Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Height" Value="46"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentHover}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.82"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
                    <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ButtonSurface" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.015" Duration="0:0:0.12"/><DoubleAnimation Storyboard.TargetName="ButtonSurface" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.015" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ButtonSurface" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.16"/><DoubleAnimation Storyboard.TargetName="ButtonSurface" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></EventTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/><Setter Property="Background" Value="#1B2637"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="LauncherShell" Opacity="0">
        <Grid.RenderTransform><TranslateTransform Y="10"/></Grid.RenderTransform>
        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#0D121C" BorderBrush="#1A2637" BorderThickness="0,0,1,0">
            <Grid Margin="26,28">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <Border Width="42" Height="42" Background="{StaticResource Accent}" CornerRadius="7" HorizontalAlignment="Left"><TextBlock Text="GO" Foreground="#07130F" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="Lumina Overlay" Foreground="{StaticResource PrimaryText}" FontSize="21" FontWeight="SemiBold" Margin="0,16,0,3"/>
                    <TextBlock Text="CONTROL CENTER" Foreground="{StaticResource MutedText}" FontSize="10" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <TextBlock Text="INSTALLATION" Foreground="{StaticResource MutedText}" FontSize="10" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource PrimaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="42,32,42,28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
                <StackPanel><TextBlock Text="Overlay status" Foreground="{StaticResource MutedText}" FontSize="12"/><TextBlock Text="Ready to play" Foreground="{StaticResource PrimaryText}" FontSize="29" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                <Border DockPanel.Dock="Right" Background="#162638" BorderBrush="#284462" BorderThickness="1" CornerRadius="6" Padding="12,7" VerticalAlignment="Center"><TextBlock Text="{Binding StatusText}" Foreground="#A9DFFF" FontSize="12" FontWeight="SemiBold"/></Border>
            </DockPanel>
            <Grid Grid.Row="1" Margin="0,34,0,26">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="7" Padding="24">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="Release notes" Foreground="{StaticResource PrimaryText}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="What changed in the current build" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                        <ScrollViewer Grid.Row="1" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Changelog}" Foreground="#BEC9D7" TextWrapping="Wrap" FontSize="13" LineHeight="21"/></ScrollViewer>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="7" Padding="22">
                    <StackPanel><TextBlock Text="Session" Foreground="{StaticResource MutedText}" FontSize="12"/><TextBlock Text="{Binding OverlayState}" Foreground="{StaticResource PrimaryText}" TextWrapping="Wrap" FontSize="14" LineHeight="20" Margin="0,10,0,24"/>
                        <Button Content="{Binding PrimaryButtonText}" Style="{StaticResource ActionButton}" IsEnabled="{Binding CanRunPrimaryAction}" Click="PrimaryButton_Click"/>
                        <Button Content="Check for updates" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" IsEnabled="{Binding CanRunPrimaryAction}" Click="CheckButton_Click"/>
                        <Separator Background="{StaticResource Border}" Margin="0,20"/>
                        <Button Content="Uninstall Lumina Overlay" Style="{StaticResource SecondaryButton}" Foreground="#FFB8C4" Background="#241720" BorderBrush="#4D2B39" IsEnabled="{Binding CanRunPrimaryAction}" Click="UninstallButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
            <StackPanel Grid.Row="2"><DockPanel Margin="0,0,0,8"><TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource MutedText}" FontSize="12"/><TextBlock DockPanel.Dock="Right" Text="{Binding Progress, StringFormat={}{0:0}%}" Foreground="{StaticResource PrimaryText}" FontSize="12"/></DockPanel><ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Progress}" Foreground="{StaticResource Accent}" Background="#1A2433"/></StackPanel>
        </Grid>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22"/>
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="0" Duration="0:0:0.22"/>
            </Storyboard></BeginStoryboard></EventTrigger>
        </Grid.Triggers>
    </Grid>
</Window>
