<Application x:Class="Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Global palette — emerald green theme -->
        <SolidColorBrush x:Key="LauncherBackground" Color="#080C12"/>
        <SolidColorBrush x:Key="PanelBackground"    Color="#0F1620"/>
        <SolidColorBrush x:Key="PanelBorder"        Color="#1E2E42"/>
        <SolidColorBrush x:Key="Accent"             Color="#22D97E"/>
        <SolidColorBrush x:Key="AccentHover"        Color="#4FEBA0"/>
        <SolidColorBrush x:Key="TextPrimary"        Color="#EEF3F8"/>
        <SolidColorBrush x:Key="TextMuted"          Color="#7A96B2"/>
    </Application.Resources>
</Application>

